{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Latch",
  "version": "0.5.1-beta.1",
  "identifier": "dev.amaansyed.latch",
  "mainBinaryName": "LatchDesktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Latch",
        "width": 860,
        "height": 620,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "visible": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
