{
  "name": "latch-router",
  "version": "0.4.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "npm run build && node --test dist/test/*.test.js",
    "e2e:mcp": "npm run build && node scripts/e2e-mcp-local.mjs",
    "accept:mcp": "npm run build && node scripts/accept-mcp.mjs",
    "token": "node scripts/generate-token.mjs",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@neondatabase/serverless": "^1.1.0",
    "@redis/client": "6.2.1",
    "ws": "8.21.3",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.2",
    "@types/ws": "8.18.1",
    "eslint": "10.9.1",
    "globals": "17.12.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.70.0"
  }
}
