{
  "name": "latch-router",
  "version": "0.4.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json",
    "build": "tsc && vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "test:web": "playwright test --config web/playwright.config.ts",
    "test": "npm run build && node --test dist/test/*.test.js",
    "e2e:mcp": "npm run build && node scripts/e2e-mcp-local.mjs",
    "accept:mcp": "npm run build && node scripts/accept-mcp.mjs",
    "token": "node scripts/generate-token.mjs",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@redis/client": "6.2.1",
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "ws": "8.21.3",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "10.9.1",
    "globals": "17.12.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.2",
    "typescript-eslint": "8.70.0",
    "vite": "^8.3.0"
  }
}
