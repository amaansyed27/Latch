{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "fluid": true,
  "functions": {
    "api/router.ts": {
      "maxDuration": 300,
      "includeFiles": "public/**"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/router?latch_public_path=/"
    },
    {
      "source": "/:page(login|signup|account|forgot-password|reset-password|dashboard|connect-chatgpt|devices|download|privacy|terms|support|security)",
      "destination": "/api/router?latch_public_path=/:page"
    },
    {
      "source": "/.well-known/:path*",
      "destination": "/api/router?latch_public_path=/.well-known/:path*"
    },
    {
      "source": "/oauth/:path*",
      "destination": "/api/router?latch_public_path=/oauth/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "/api/router?latch_public_path=/assets/:path*"
    },
    {
      "source": "/mcp",
      "destination": "/api/router?latch_mcp=1"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/router?latch_path=:path*"
    },
    {
      "source": "/:path*",
      "destination": "/api/router?latch_public_path=/:path*"
    }
  ]
}
